 "recipe": [
  {
   "order": 1,
   "goal": "Derive analytical model for density and azimuthal velocity in a thermally stratified disk",
   "method": "Analytically solve vertical hydrostatic equilibrium and radial centrifugal balance including vertical temperature stratification and disk self-gravity, implemented in the code DYSC.",
   "software": [
    "DYSC"
   ],
   "key_parameters": [],
   "assumptions": [
    "Self-similar surface density profile from Lynden-Bell & Pringle (1974)",
    "Barotropic fluid in vertical hydrostatic equilibrium and radial centrifugal balance; mean molecular weight mu = 2.1",
    "Dullemond et al. (2020) 2D temperature prescription"
   ]
  },
  {
   "order": 2,
   "goal": "Validate analytical model with 3D SPH hydrodynamical simulations",
   "method": "Run SPH simulation of a thermally stratified disk with MWC 480 parameters for eight outer orbits (~45 kyr) until relaxed, and compare azimuthally averaged density and velocity in 50 radial bins at z = 20 au (for R > 100 au) against isothermal and stratified analytical models.",
   "software": [
    "phantom"
   ],
   "key_parameters": [
    "N = 10^6 gas particles, gamma = 1, R_c = 150 au, R_in = 10 au, R_out = 400 au, M_star = 2.1 M_sun, alpha_SS = 0.005",
    "Dullemond temperature parameters: zeta_0 = 7 au, alpha = 2.78, beta = -0.05, T_mid,100 = 27 K, q = 0.23, T_atm,100 = 69 K, q_atm = 0.7"
   ],
   "assumptions": [
    "No self-gravity or dust included in the simulation"
   ]
  },
  {
   "order": 3,
   "goal": "Extract 12CO and 13CO rotation curves from MAPS datacubes",
   "method": "Extract frontside velocities from moment maps using Gaussian (MWC 480, AS 209) or double-Bell decomposition (IM Lup, GM Aur, HD 163296) based on velocity priors from discminer models.",
   "software": [
    "discminer"
   ],
   "key_parameters": [
    "Orientation (i, PA) and extraction methods (Gauss or Dbell) as listed in Table 1"
   ],
   "assumptions": [
    "Emitting layer height parameterized as tapered power law z(R) with parameters from Izquierdo et al. (2023)"
   ]
  },
  {
   "order": 4,
   "goal": "Fit rotation curves for stellar mass, disk mass, and scale radius",
   "method": "Simultaneously fit 12CO and 13CO rotation curves using MCMC for both vertically isothermal and thermally stratified models including disk self-gravity, and evaluate relative squared velocity differences (v_13^2 - v_12^2)/v_13^2.",
   "software": [
    "DYSC"
   ],
   "key_parameters": [
    "Free parameters: M_star, M_d, R_c; fixed thermal and surface parameters from Table 1"
   ],
   "assumptions": [
    "Fixed 1D/2D temperature profiles from Zhang et al. (2021) and Law et al. (2021) and fixed emitting surfaces from Izquierdo et al. (2023)"
   ]
  },
  {
   "order": 5,
   "goal": "Compute dust masses, gas-to-dust ratios, and Toomre Q profiles",
   "method": "Compute dust mass from 283 GHz continuum flux density using Hildebrand (1983) optically thin relation, combine with stratified-model disk gas mass to obtain gas-to-dust ratio, and compute radial Toomre Q profile using best-fit stratified parameters.",
   "software": [],
   "key_parameters": [
    "nu = 283 GHz, T = 20 K, kappa_nu = 2.3 (nu / 230 GHz)^0.4 cm^2 g^-1"
   ],
   "assumptions": [
    "Optically thin dust continuum emission at 283 GHz with T = 20 K; nearly Keplerian disk (kappa approx Omega) for Toomre Q; for AS 209, upper limit on M_d taken as 5% of M_star for gas-to-dust ratio."
   ]
  }
 ],
