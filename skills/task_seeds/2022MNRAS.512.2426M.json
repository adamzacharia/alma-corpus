 "recipe": [
  {
   "order": 1,
   "goal": "Re-calibrate archival ALMA visibilities, measure 873 um continuum flux, and estimate visibility noise",
   "method": "Re-calibrate ALMA science archive visibilities using archive scripts in CASA 4.3.1, image with tclean in CASA 6.1.2.7 using natural weighting and primary beam correction to measure 873 um flux, and run CASA statwt to measure 1-sigma visibility scatter across all baselines.",
   "software": [
    "CASA",
    "tclean",
    "statwt"
   ],
   "key_parameters": [
    "natural weighting, primary beam corrected, pixel scale 0.02 arcsec (H-ATLAS) and 0.03 arcsec (HeLMS)"
   ],
   "assumptions": [
    "Uncorrelated visibility noise represented by diagonal covariance matrix"
   ]
  },
  {
   "order": 2,
   "goal": "Perform uv-plane strong lens modelling and pixelised source reconstruction",
   "method": "Semi-linear inversion (SLI) directly on visibilities in the uv-plane using PyAutoLens, PyNUFFT, and PyLops, fitting elliptical power-law mass density profiles (1 for galaxy-scale, 2 for group-scale) plus optional external shear, first with magnification-adapted source pixelisation and then brightness-adapted source pixelisation.",
   "software": [
    "PyAutoLens",
    "PyNUFFT",
    "PyLops",
    "DYNESTY"
   ],
   "key_parameters": [
    "Constant-weight gradient regularisation; 6 to 14 lens mass model parameters plus regularisation and number of source pixels"
   ],
   "assumptions": [
    "Elliptical power-law surface mass density profile (1 or 2 components) with optional external shear"
   ]
  },
  {
   "order": 3,
   "goal": "Compute source magnification profiles and total magnification factors",
   "method": "Rank source plane pixels above a surface brightness threshold by flux density and compute the ratio of lensed image-plane flux (within the image-plane mask) to source-plane flux, repeating 100 times with randomised source plane pixelisation to average.",
   "software": [
    "PyAutoLens"
   ],
   "key_parameters": [
    "100 realisations of randomised source plane pixelisation; surface brightness threshold; image plane mask"
   ],
   "assumptions": []
  },
  {
   "order": 4,
   "goal": "Fit demagnified multi-wavelength SEDs and derive intrinsic dust mass, IR luminosity, gas mass, and SFR",
   "method": "Demagnify observed sub-mm/mm photometry by total magnification factor, fit rest-frame photometry with both a single-temperature optically thick SED and a dual-temperature optically thin SED, integrate the optically thin SED from 3 to 1100 um for L_IR, compute dust mass bounds using 873 um flux, H2 gas mass via scaling relations, and SFR from L_IR.",
   "software": [],
   "key_parameters": [
    "Dust emissivity index beta = 2.0; integration range 3-1100 um"
   ],
   "assumptions": [
    "Flat LambdaCDM cosmology with h = 0.677 and Omega_m = 0.307",
    "Dust mass absorption coefficient extrapolated from kappa_850 = 0.077 m^2 kg^-1 to 873 um, constant across sample",
    "Kroupa IMF conversion log(SFR) = log(L_IR) - 43.41 assuming all IR emission is from star formation (no AGN contribution)"
   ]
  }
 ],
