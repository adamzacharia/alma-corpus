   ],
   "assumptions": []
  },
  {
   "order": 2,
   "goal": "Measure continuum flux and position",
   "method": "imfit 2D Gaussian within 0.5\" of brightest pixel; flux in r<0.5\"",
   "software": [
    "CASA imfit"
   ],
   "key_parameters": [],
   "assumptions": []
  },
  {
   "order": 3,
   "goal": "Fit OH profile",
   "method": "Least-squares fit of two double-Gaussians (absorption outflow + emission systemic); doublet separation fixed at 521 km/s, equal peaks and FWHMs; constant continuum",
   "software": [
    "Python scipy.optimize.curve_fit"
   ],
   "key_parameters": [],
   "assumptions": []
  },
  {
   "order": 4,
   "goal": "Derive outflow mass and rate",
   "method": "Optical depth, LTE OH column density from equivalent width, N_H2 via abundance, thin shell M=mu mH N_H Omega r^2, Mdot=M v/r; empirical relation as check",
   "software": [],
   "key_parameters": [
    "Tex=50 K, Q≈19, [OH]/[H2]=5e-7, f=0.3, r_out=2 kpc, v_out=669 km/s"
   ],
   "assumptions": [
    "OH abundance 5e-7 chosen as compromise and to match the empirical relation"
   ]
  },
  {
   "order": 5,
   "goal": "Resolved OH spectra",
   "method": "Extract spectra from 0.1\"x0.1\" regions and double-Gaussian fit each",
   "software": [
    "scipy"
   ],
   "key_parameters": [],
   "assumptions": []
  },
  {
   "order": 6,
   "goal": "AGN fraction, LIR, SFR via SED",
   "method": "CIGALE SED fitting with delayed SFH, DL07 dust, Fritz AGN, solar/2 metallicity, two torus inclinations",
