  "claims": [
   {
    "hypothesis": "Is X-ray polarization of LSP/ISP blazars detectable and which emission models does it favor?",
    "experiment": "IXPE 2–8 keV polarimetry with contemporaneous radio/optical polarization",
    "result": "No detections; upper limits ~9–28%",
    "finding": "Favors Compton-dominated X-rays; hadronic models not fully eliminated; proton synchrotron strongly disfavored in 3C 279",
    "support": "supported",
    "evidence": [
     {
      "loc": "abstract",
      "quote": "The undetected polarizations favor models where the X-ray band is dominated by unpolarized photons upscattered by relativistic electrons"
     }
    ]
